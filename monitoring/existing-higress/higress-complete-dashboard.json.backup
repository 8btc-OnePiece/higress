      "pluginVersion": "9.5.6",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(container_memory_working_set_bytes{namespace=\"agent\", container=\"higress\"}) / 1024 / 1024",
          "legendFormat": "实际使用",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_pod_container_resource_requests{namespace=\"agent\", resource=\"memory\", container=\"higress\"} / 1024 / 1024",
          "legendFormat": "分配",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(kube_pod_container_resource_requests{namespace=\"agent\", resource=\"memory\", container=\"higress\"} - max(container_memory_working_set_bytes{namespace=\"agent\", container=\"higress\"})) / 1024 / 1024",
          "legendFormat": "剩余可用",
          "refId": "C"
        }
      ],
      "title": "POD 内存分配情况 (MB)",
      "type": "stat"
